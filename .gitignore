# Godot 4+ specific ignores
.godot/
/android/
.smoke*/

# Third-party binaries and packages: fetched, not committed
server/node_modules/
addons/webrtc/

# Personal Claude Code settings (permissions, not project config)
.claude/settings.local.json

# Generated by tools and MCP servers, never committed
__pycache__/
.playwright-mcp/

# Scratch: tools/_*.gd are throwaway probes, not tests (see tools/_probe_ui.gd)
tools/_*.gd
tools/_*.gd.uid

# Source archives dropped in the project root; the UI mockups are already
# extracted into tasks/ui-redesign-handoff/
*.zip

# The owner's model inbox: raw Meshy exports land here and are copied into
# assets/models/ under game names. Its .gdignore keeps Godot from importing them twice.
Meshy Models/*
!Meshy Models/.gdignore

# The static props (assets/models/props/<place>/*.glb, 1.4 GB) are too big for
# the LFS quota. The folders and README stay in git; the files travel as
# props.zip (tools\pack_props.cmd), unzipped into assets\models\. The game
# plays without them: a missing model draws as a box.
assets/models/props/**/*.glb
assets/models/props/**/*.glb.import
# ...and the textures Godot's importer extracts beside each of them.
assets/models/props/**/*.jpg
assets/models/props/**/*.jpg.import
assets/models/props/**/*.png
assets/models/props/**/*.png.import
# The owner's inbox copy of the structure models under their Meshy names;
# the game's copies are assets/models/structures/.
assets/models/buildable_props/

# Blender save backups
*.blend1
.lab/
