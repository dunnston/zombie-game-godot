# Godot 4+ specific ignores
.godot/
/android/
.smoke*/

# Third-party binaries and packages: fetched, not committed
server/node_modules/
addons/webrtc/

# Personal Claude Code settings (permissions, not project config)
.claude/settings.local.json

# Generated by tools and MCP servers, never committed
__pycache__/
.playwright-mcp/

# Scratch: tools/_*.gd are throwaway probes, not tests (see tools/_probe_ui.gd)
tools/_*.gd
tools/_*.gd.uid

# Source archives dropped in the project root; the UI mockups are already
# extracted into tasks/ui-redesign-handoff/
*.zip

# The owner's model inbox: raw Meshy exports land here and are copied into
# assets/models/ under game names. Its .gdignore keeps Godot from importing them twice.
Meshy Models/*
!Meshy Models/.gdignore
